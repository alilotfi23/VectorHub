# Copy to .env and fill in real values. Never commit .env.

# --- App ---
APP_NAME=vectorhub-platform
ENVIRONMENT=dev
# Structured log rendering: console (human-readable) or json (one object per
# line, for staging/prod log pipelines).
LOG_FORMAT=console

# --- Serving (python -m app.main: one process, two apps) ---
# Public API: the /api/v1 surface only. It exposes NO /health or /metrics.
API_HOST=0.0.0.0
API_PORT=8000
# Internal admin app: /health and /metrics on a separate port, so public
# traffic can never hit the probe/scrape endpoints. The boundary is network
# exposure: never publish this port / never expose it via ingress or LB.
# 127.0.0.1 is the safe single-host default; container orchestrators (compose
# healthchecks, k8s probes) must set ADMIN_HOST=0.0.0.0 instead.
ADMIN_HOST=127.0.0.1
ADMIN_PORT=9091

# --- Postgres ---
# Runtime app role. The migrator role (below) is used by Alembic only.
DATABASE_URL=postgresql+asyncpg://app:CHANGE_ME@localhost:5432/vectorhub
MIGRATOR_DATABASE_URL=postgresql+asyncpg://migrator:CHANGE_ME@localhost:5432/vectorhub

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
# TTL for cached auth lookups (API-key principals, jti deny-list markers).
# Revocation invalidates immediately regardless; Postgres stays authoritative.
AUTH_CACHE_TTL_SECONDS=300
# Worker heartbeat freshness for GET /health (seconds). The Phase 6 arq worker
# writes vhk:worker:heartbeat:<id> = <epoch-ts>; the probe checks that at least
# one heartbeat is newer than this.
WORKER_HEARTBEAT_TTL_SECONDS=30

# --- Rate limiting ---
# Platform-wide QPS ceiling per route (token bucket, burst = rate * multiplier).
RATE_LIMIT_DEFAULT_QPS=100
# Per-route overrides as JSON, keyed by "METHOD /path", e.g.:
# RATE_LIMIT_ROUTE_QPS={"POST /api/v1/auth/login": 5}
RATE_LIMIT_BURST_MULTIPLIER=2
# Tenant (tenants.rate_limit_qps) and API-key (api_keys.rate_limit_qps) caps
# apply per-row when set; unset = no cap beyond the route default.
# RATE_LIMIT_CONFIG_CACHE_TTL_SECONDS=300

# --- Auth / JWT ---
# HS256 with a strong random secret in staging/prod (openssl rand -hex 32).
# The app refuses to boot in staging/prod with the dev default below.
JWT_SECRET=dev-secret-change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
# Comma-separated emails granted platform-admin at registration time.
# Set before the first register in a new deployment, e.g.:
# BOOTSTRAP_PLATFORM_ADMIN_EMAILS=admin@example.com
BOOTSTRAP_PLATFORM_ADMIN_EMAILS=

# --- CORS ---
# Local/dev: permissive.
CORS_ALLOWED_ORIGINS=*
# Staging/prod: explicit allow-list.
# CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com

# --- Vector contract limits ---
VECTOR_MAX_DIMENSION=4096
SPARSE_MAX_CARDINALITY=100000

# --- Batch staging (MinIO local / S3 cloud) ---
BATCH_STORAGE_ENDPOINT=http://localhost:9000
BATCH_STORAGE_ACCESS_KEY=minioadmin
BATCH_STORAGE_SECRET_KEY=minioadmin
BATCH_STORAGE_BUCKET=vectorhub-batches

# --- Vector backends ---
QDRANT_URL=http://localhost:6333
WEAVIATE_URL=http://localhost:8080
MILVUS_URL=http://localhost:19530
CHROMA_URL=http://localhost:8000
